# 서버 PC 의 Tailscale IPv4 주소 (`tailscale ip -4` 결과). 필수.
# 모든 포트가 이 주소에만 열린다. 공인 IP·LAN IP 를 넣지 말 것.
TS_IP=

# 로그인한 기기에 내려 줄 서버 주소 (ID 서버 · 릴레이 · API 서버 공통).
# 이 서버 PC 의 MagicDNS 전체 이름을 권장한다. 비우면 TS_IP 를 쓴다.
SERVER_HOST=rustdesk-server.example.ts.net

# 포트 (기기에서 보이는 서버 포트). 기존 RustDesk 서버와 같은 PC 에서 나란히 시험할 때만 바꾼다.
# HBBS_NAT_PORT 는 반드시 HBBS_PORT - 1 (클라이언트가 ID 포트 - 1 로 NAT 검사를 한다).
# API_PORT=22114
# HBBS_NAT_PORT=22115
# HBBS_PORT=22116
# HBBR_PORT=22117

# 로그인 토큰 수명 (Go duration). 쓰는 동안은 자동 연장된다.
TOKEN_TTL=720h

# 공식 rustdesk-server 이미지 태그 (hbbs/hbbr)
RUSTDESK_SERVER_TAG=1.1.16
