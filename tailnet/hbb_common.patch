diff --git a/src/tailnet.rs b/src/tailnet.rs
new file mode 100644
index 0000000..501d0e4
--- /dev/null
+++ b/src/tailnet.rs
@@ -0,0 +1,75 @@
+//! Tailnet-only networking: every peer, server and relay must be reached over Tailscale.
+//!
+//! Allowed: Tailscale CGNAT range `100.64.0.0/10`, Tailscale ULA `fd7a:115c:a1e0::/48`
+//! and loopback (IPC, local tests). Everything else is refused at the socket layer.
+
+use std::net::{IpAddr, SocketAddr};
+
+pub fn is_allowed_ip(ip: IpAddr) -> bool {
+    let ip = match ip {
+        IpAddr::V6(v6) => v6
+            .to_ipv4_mapped()
+            .map(IpAddr::V4)
+            .unwrap_or(IpAddr::V6(v6)),
+        ip => ip,
+    };
+    if ip.is_loopback() {
+        return true;
+    }
+    match ip {
+        IpAddr::V4(v4) => {
+            let o = v4.octets();
+            o[0] == 100 && (o[1] & 0xc0) == 64
+        }
+        IpAddr::V6(v6) => {
+            let s = v6.segments();
+            s[0] == 0xfd7a && s[1] == 0x115c && s[2] == 0xa1e0
+        }
+    }
+}
+
+#[inline]
+pub fn is_allowed_addr(addr: &SocketAddr) -> bool {
+    is_allowed_ip(addr.ip())
+}
+
+pub fn check_addr(addr: &SocketAddr) -> crate::ResultType<()> {
+    if is_allowed_addr(addr) {
+        Ok(())
+    } else {
+        crate::bail!("tailnet-only: {} is not a Tailscale address", addr)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn allows_only_tailscale_and_loopback() {
+        for ok in [
+            "100.64.0.1",
+            "100.101.1.1",
+            "100.127.255.254",
+            "fd7a:115c:a1e0::1",
+            "127.0.0.1",
+            "::1",
+            "::ffff:100.101.2.2",
+        ] {
+            assert!(is_allowed_ip(ok.parse().unwrap()), "{}", ok);
+        }
+        for bad in [
+            "203.0.113.10",
+            "10.62.179.10",
+            "192.168.0.10",
+            "100.63.255.255",
+            "100.128.0.1",
+            "0.0.0.0",
+            "2001:db8::1",
+            "fd7a:115c:a1e1::1",
+            "::ffff:203.0.113.10",
+        ] {
+            assert!(!is_allowed_ip(bad.parse().unwrap()), "{}", bad);
+        }
+    }
+}
